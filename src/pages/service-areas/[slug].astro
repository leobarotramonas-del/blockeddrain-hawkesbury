---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqSection from '../../components/FaqSection.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import HonestReviews from '../../components/HonestReviews.astro';
import { areaFaqs, areas, services, site } from '../../data/site';
import { faqSchema } from '../../data/faqs';
export function getStaticPaths() { return areas.map((area) => ({ params: { slug: area.slug }, props: { area } })); }
const { area } = Astro.props;
const faqs = areaFaqs[area.slug];
const schema = [{
  '@context': 'https://schema.org', '@type': 'Service',
  name: `Blocked Drain Plumber in ${area.name} NSW ${area.postcode}`,
  description: `${area.intro} ${area.context}`,
  serviceType: `Blocked drain diagnosis, clearing and repair in ${area.name}`,
  category: ['Blocked drains', 'Drain inspection', 'Drain clearing', 'Drain repairs'],
  provider: { '@type': 'Plumber', name: site.name, alternateName: site.operator, telephone: '+61 493 824 176' },
  areaServed: { '@type': 'Place', name: `${area.name}, NSW ${area.postcode}, Australia`, address: { '@type': 'PostalAddress', addressLocality: area.name, addressRegion: 'NSW', postalCode: area.postcode, addressCountry: 'AU' } },
  audience: { '@type': 'Audience', audienceType: `${area.name} property owners, residents and property managers` },
  serviceOutput: `Assessed and cleared drainage where suitable, with findings and repair options explained for ${area.name} properties`,
}, faqSchema(faqs)];
---
<BaseLayout title={`Blocked Drains ${area.name} NSW ${area.postcode}`} description={`Blocked drain plumber for ${area.name} NSW ${area.postcode}. CCTV inspection, drain jetting, root removal and pipe repair options. Urgent calls are taken 24/7.`} schema={schema}>
  <PageHero label={`${area.name} NSW ${area.postcode}`} title={`Blocked Drains ${area.name}`} intro={area.intro} image={area.slug === 'kurrajong' ? '/images/cctv-root-intrusion.jpeg' : area.image} imageAlt={area.imageAlt} />
  {area.slug === 'agnes-banks' && <section class="section agnes-guide" aria-labelledby="agnes-guide-title"><div><p class="agnes-guide__label">Agnes Banks drainage</p><h2 id="agnes-guide-title">What is backing up, and where?</h2><p>A toilet or gully overflow points to a different line from a pit filling during rain. Tell us which fixture or pit is affected, whether other drains have slowed, and if the problem returns after clearing. We can assess <a href="/services/blocked-sewer-drains">sewer blockages</a> and <a href="/services/blocked-stormwater-drains">stormwater drainage</a> without assuming sand, roots or pipe damage is the cause.</p><p>If wastewater is escaping, stop using connected fixtures and keep people and pets away. Do not enter pits or flooded ground.</p></div><div class="agnes-guide__booking"><h3>Help us plan the visit</h3><ul><li>Give the full street address and a phone number for someone at the property.</li><li>Describe gates, driveway width, steep or soft ground, and how far the affected drain is from vehicle access.</li><li>Point out any known inspection openings and share previous clearing dates or camera findings.</li><li>For a rental or shared property, identify who can approve access and any repair work.</li></ul><p>We will discuss an appropriate clearing method, whether <a href="/services/cctv-drain-inspections">camera inspection</a> would help with a recurring fault, and the next available response. A damaged section needs its own <a href="/services/drain-repairs-excavation">repair assessment</a>.</p><a class="call-button" href={site.phoneHref}><span>Call about your drain</span><strong>{site.phoneDisplay}</strong></a></div></section>}
  <section class="section local-causes"><div><h2>Drainage in {area.name}</h2><p>{area.context}</p><p>{area.access}</p><p>{area.coverage}</p><h2>Response Planning</h2><p>{area.responseGuide}</p><p>{area.urgentCopy}</p></div><div><h2>Problems We Look For</h2><ul class="check-list">{area.causes.map((cause) => <li>{cause}</li>)}</ul><h2>Local Service Capability</h2><ul class="check-list">{area.expertise.map((item) => <li>{item}</li>)}</ul></div></section>
  {area.slug === 'kurrajong' && <section class="field-proof"><header><h2>Blocked-drain work in Kurrajong</h2><p>Supplied field media from Kurrajong shows the work behind diagnosis, clearing and a professional next step.</p></header><div class="field-proof__grid"><figure><ResponsiveImage src="/images/cctv-root-intrusion.jpeg" alt="CCTV view of roots inside a blocked drain" widths={[480,720]} sizes="(max-width:760px) 100vw, 33vw" loading="lazy" /><figcaption>Roots visible inside the pipe during camera inspection</figcaption></figure><figure class="field-video"><video controls preload="none" poster="/images/drain-jetting-team.jpeg" aria-label="Kurrajong blocked drain field video"><source src="/videos/kurrajong-field-reel.mp4" type="video/mp4" /><track kind="captions" src="/captions/kurrajong-field-reel.en.vtt" srclang="en" label="English" default /></video><figcaption>Blocked-drain diagnosis and clearing in Kurrajong</figcaption></figure></div></section>}
  <section class="section slim-section"><h2>Blocked-Drain Services in {area.name}</h2><p>Compare all <a href="/services">blocked-drain services</a>, see our wider <a href="/service-areas">Hawkesbury service area</a>, read <a href="/about">about the licensed team</a>, or <a href="/contact">call about your address</a>.</p><div class="service-list">{services.map((service, index) => <a class="service-row" href={`/services/${service.slug}`}><span>{String(index + 1).padStart(2, '0')}</span><h3>{service.name}</h3><p>{service.summary}</p></a>)}</div></section>
  <HonestReviews intro={`Customer feedback about the licensed team providing drainage help across ${area.name} and the wider Hawkesbury.`} />
  <FaqSection title={`${area.name} Blocked-Drain Questions`} intro={`Practical answers about drain clearing, inspection and repair in ${area.name}.`} items={faqs} />
  <CtaBand title={`Blocked drain in ${area.name}?`} />
</BaseLayout>
<style>
  .agnes-guide{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);align-items:start;border-block:1px solid var(--line, #bcc5cf)}
  .agnes-guide__label{color:var(--blue);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .agnes-guide__booking{background:#eef3f8;border-top:4px solid #081939;padding:clamp(1.5rem,3vw,2.25rem)}
  .agnes-guide__booking h3{margin-top:0}
  .agnes-guide__booking li{margin-bottom:.65rem}
  .agnes-guide__booking .call-button{margin-top:.25rem}
  @media(max-width:760px){.agnes-guide{grid-template-columns:1fr}.agnes-guide__booking .call-button{width:100%;flex-wrap:wrap;line-height:1.2}}
</style>
