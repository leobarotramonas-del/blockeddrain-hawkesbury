---
import ProjectShowcase from "../components/ProjectShowcase.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleReviewBadge from '../components/GoogleReviewBadge.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import CtaBand from '../components/CtaBand.astro';
import { areas, faqs, services, site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Plumber', name: site.name, alternateName: site.operator, telephone: '+61 493 824 176', areaServed: areas.map((area) => ({ '@type': 'Place', name: `${area.name}, NSW ${area.postcode}` })), knowsAbout: services.map((service) => service.name) },
    { '@type': 'FAQPage', mainEntity: faqs.slice(0, 4).map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ],
};

---
<BaseLayout title="Blocked Drains Hawkesbury — Urgent Calls 24/7" description="Blocked drain plumber for Hawkesbury homes, acreage and businesses. CCTV inspection, water jetting, root removal and drain repairs. Urgent calls are taken 24/7." schema={schema}>
  <div class="drain-home">
    <section class="drain-hero" aria-labelledby="hero-title">
      <div class="drain-hero__copy">
        <div class="drain-hero__review"><GoogleReviewBadge /></div>
        <h1 id="hero-title">Clear the blocked drain. <em>Find the cause.</em></h1>
        <p class="drain-hero__lead">Antons Blocked Drains Hawkesbury clears sewer and stormwater blockages, overflowing toilets and tree roots. We investigate recurring faults, explain the repair options and check flow after clearing. Urgent drain calls are taken 24/7.</p>
        <div class="drain-hero__actions">
          <a class="call-button" href={site.phoneHref}><span>Urgent calls 24/7</span><strong>{site.phoneDisplay}</strong></a>
          <a class="plain-action" href="#proof">See project footage</a>
        </div>
        <p class="operator-line">A specialist Hawkesbury blocked-drain service by {site.operator} · NSW contractor licence {site.licence}</p>
      </div>
      <div class="drain-hero__media">
        <ResponsiveImage src="/images/drain-jetting-team.jpeg" alt="Blocked-drain technician operating professional high-pressure jetting equipment" widths={[360, 480, 672, 960, 1200]} sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1180px) 54vw, 605px" loading="eager" fetchpriority="high" quality={64} />
        <div class="hero-equipment"><strong>Professional drain clearing</strong><span>Jetting · CCTV · locating · repairs</span></div>
      </div>
    </section>

    <section class="decision-strip" aria-label="Blocked drain warning signs">
      <strong>Stop using the drain and call if:</strong>
      <span>Sewage is overflowing</span><span>Multiple fixtures back up</span><span>The only toilet is unusable</span><span>Water threatens the building</span>
    </section>

    <section class="drain-section service-index" aria-labelledby="services-heading">
      <header class="split-heading"><h2 id="services-heading">Blocked-drain help built around the actual fault</h2><p>Choose a service to understand the assessment, equipment and repair options.</p></header>
      <div class="service-index__list">
        {services.map((service) => <a href={`/services/${service.slug}`}><div><h3>{service.name}</h3><p>{service.summary}</p></div><span>View service</span></a>)}
      </div>
    </section>

    <ProjectShowcase heading="Recent drainage projects in the Hawkesbury and across Sydney" items={["drain-overflow-response", "drain-pipework-installation", "restricted-access-excavation"]} id="proof" />

    <section class="drain-section areas-section" aria-labelledby="areas-title">
      <header class="split-heading"><h2 id="areas-title">Blocked drain plumbers across the Hawkesbury</h2><p>Call with your full address to confirm coverage, access and the next available response.</p></header>
      <div class="area-cloud">{areas.map((area) => <a href={`/service-areas/${area.slug}`}><strong>{area.name}</strong><span>NSW {area.postcode} · {area.dispatchMinutes}</span></a>)}</div>
    </section>

    <section class="drain-section faq-section" aria-labelledby="faq-title">
      <header class="split-heading"><h2 id="faq-title">What to know before you call</h2><p>Useful, direct answers for the first few minutes of a blocked-drain problem.</p></header>
      <div class="faq-lines">{faqs.slice(0, 4).map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
    </section>
  </div>
  <CtaBand title="Blocked drain in the Hawkesbury?" text="Call with your suburb, the affected fixtures and whether water or sewage is overflowing." />
</BaseLayout>
