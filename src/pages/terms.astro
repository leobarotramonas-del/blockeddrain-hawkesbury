---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Website Terms" description="Read the Antons Blocked Drains Hawkesbury website terms covering general drainage information, the licensed operator, urgent situations, pricing and availability.">
  <article class="legal-page"><h1>Website Terms</h1><p>Last updated 12 October 2026.</p><h2>General Information</h2><p>This website provides general information about blocked-drain and drainage services. It is not a quote, diagnosis or guarantee of availability.</p><h2>Service Provider</h2><p>{site.name} is a specialist blocked-drain service provided by {site.operator}. Regulated work is performed under NSW contractor licence {site.licence}.</p><h2>Urgent Situations</h2><p>If there is immediate danger, contaminated water near electricity, fire or threat to life, leave the area and contact the appropriate emergency service. Calling this business is not a substitute for emergency services.</p><h2>Accuracy</h2><p>We aim to keep service and contact information current, but specific scope, pricing, coverage and availability must be confirmed directly.</p></article>
</BaseLayout>
