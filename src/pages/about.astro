---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { faqSchema, pageFaqs } from '../data/faqs';
---
<BaseLayout title="Licensed Blocked Drain Plumbers Hawkesbury" description="Meet the licensed blocked-drain team serving Hawkesbury properties and learn how professional diagnosis, drain equipment and evidence-led repair planning protect local drainage." schema={faqSchema(pageFaqs.about)}>
  <PageHero label="About the Service" title="Licensed blocked-drain plumbers for Hawkesbury properties" intro="Professional diagnosis, drain-clearing equipment and evidence-led repair planning from a team working under a current NSW contractor licence." image="/images/antons-drain-service-vehicle.jpeg" imageAlt="Blocked-drain service vehicle equipped for Hawkesbury drainage work" />
  <section class="section detail-grid"><div><h2>Blocked-Drain Capability You Can See</h2><p>Our work covers the full blocked-drain journey: urgent overflow triage, safe access, high-pressure cleaning, CCTV inspection, electronic location and targeted pipe repair where required.</p><p>The goal is not to sell the most equipment. It is to use the right method at the right stage and explain what the evidence means for your property.</p></div><div><h2>Licensed Hawkesbury Drainage Work</h2><p>{site.name} is a dedicated blocked-drain service from {site.operator}. Regulated work is performed under NSW contractor licence {site.licence}.</p><p>The website keeps the customer journey focused on Hawkesbury drainage while making the service provider and licence clear on key trust and legal pages.</p></div></section>
  <section class="operator-gallery"><ResponsiveImage src="/images/drain-jetting-team.jpeg" alt="Licensed technician using professional blocked-drain equipment" sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /><ResponsiveImage src="/images/drain-repair-excavation.jpeg" alt="Underground drain repair using drainage-grade pipe and fittings" sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /></section>
  <FaqSection title="About the Hawkesbury Drain Service" intro="Answers about the operator, licence, proof and availability." items={pageFaqs.about} />
  <CtaBand />
</BaseLayout>
