---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { faqSchema, pageFaqs } from '../data/faqs';
---
<BaseLayout title="About Antons Blocked Drains Hawkesbury" description="Meet the licensed team behind Antons Blocked Drains Hawkesbury and learn how professional diagnosis, drain equipment and evidence-led repair planning protect local properties." schema={faqSchema(pageFaqs.about)}>
  <PageHero label="About the Service" title="Drain specialists who look past the symptom." intro="A Hawkesbury-focused drainage service backed by experienced people, professional equipment and a clear NSW licence." image="/images/antons-drain-service-vehicle.jpeg" imageAlt="Antons plumbing and drainage service vehicle" />
  <section class="section detail-grid"><div><h2>Capability You Can See</h2><p>Our work covers the full blocked-drain journey: urgent overflow triage, safe access, high-pressure cleaning, CCTV inspection, electronic location and targeted pipe repair where required.</p><p>The goal is not to sell the most equipment. It is to use the right method at the right stage and explain what the evidence means for your property.</p></div><div><h2>Licensed Responsibility</h2><p>Antons Blocked Drains Hawkesbury is operated by {site.operator}. Regulated work is performed under NSW contractor licence {site.licence}.</p><p>The public brand keeps the website focused on Hawkesbury drainage, while the operator and licence remain clear where they matter.</p></div></section>
  <section class="operator-gallery"><ResponsiveImage src="/images/drain-jetting-team.jpeg" alt="Antons technician using blocked drain equipment" sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /><ResponsiveImage src="/images/drain-repair-excavation.jpeg" alt="Underground drain repair using drainage-grade pipe and fittings" sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /></section>
  <FaqSection title="About the Hawkesbury Drain Service" intro="Answers about the operator, licence, proof and availability." items={pageFaqs.about} />
  <CtaBand />
</BaseLayout>
