---
import { getBlogGuides } from '../data/blog-guides';
import BlogGuideCard from './BlogGuideCard.astro';
const { service, title='Latest plumbing guides' } = Astro.props;
const posts=await getBlogGuides();
const selected=service?posts.filter(p=>p.service?.replace(/[/]$/,'')===service.replace(/[/]$/,'')):posts;
---
{selected.length>0 && <section class="w1-guides" data-guide-feed><h2>{title}</h2><div class="guide-grid">{selected.map(post=><BlogGuideCard post={post} />)}</div></section>}
