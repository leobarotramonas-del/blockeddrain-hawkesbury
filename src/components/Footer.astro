---
import { areas, services, site } from '../data/site';
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-brand">
      <a class="drain-brand drain-brand--footer" href="/" aria-label="Antons Blocked Drains Hawkesbury home"><strong>ANTONS</strong><span>BLOCKED DRAINS</span><small>HAWKESBURY</small></a>
      <p>{site.name} is a specialist blocked-drain service from <a class="footer-operator" href="https://antonsplumbingandgas.com.au/">{site.operator}</a>. NSW contractor licence {site.licence}. Urgent drain calls are taken 24/7.</p>
    </div>
    <div><h2>Services</h2>{services.map((item) => <a href={`/services/${item.slug}`}>{item.name}</a>)}</div>
    <div><h2>Service Areas</h2>{areas.map((area) => <a href={`/service-areas/${area.slug}`}>{area.name}</a>)}</div>
    <div><h2>Contact</h2><a href={site.phoneHref}>{site.phoneDisplay}</a><a href="/contact">Contact Us</a><a class="footer-blog-link" href="/blog">Blogs</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
  </div>

</footer>

<style>
 footer a.footer-operator{display:inline;margin:0;padding:0;color:inherit;font:inherit;text-decoration:underline;text-underline-offset:3px}
 footer a.footer-operator:focus-visible{outline:2px solid currentColor;outline-offset:3px}
</style>
